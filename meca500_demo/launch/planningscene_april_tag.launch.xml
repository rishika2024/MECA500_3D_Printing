<?xml version="1.0"?>
<launch>
  <arg name="rviz_config" default="$(find-pkg-share meca500_demo)/config/planningscene_april_tag.rviz"/>
  <arg name="serial_no" default=""/>

  <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
    <arg name="camera_name" value="camera"/>
    <arg name="camera_namespace" value="camera"/>
    <arg name="serial_no" value="$(var serial_no)"/>
    <arg name="enable_color" value="true"/>
    <arg name="enable_depth" value="false"/>
    <arg name="pointcloud.enable" value="false"/>
  </include>

  <!-- The camera pose in link_0__base (straight-down mount, 180deg about Y,
       CAD plus measured offsets) used to be published here as a
       static_transform_publisher from link_0__base to
       camera_color_optical_frame. That fought realsense2_camera, which also
       publishes that frame's parent (camera_color_frame is its parent there),
       so tf2 kept only one parent and link_0__base and the camera ended up in
       two disconnected trees; planningscene_april_tag then saw "0 of 4 corner
       tags". The camera pose now lives as parameters on the
       planningscene_april_tag node (camera_translation, camera_rotation_xyzw)
       and is applied in process, so nothing competes for
       camera_color_optical_frame's parent. -->

  <node pkg="apriltag_ros" exec="apriltag_node" name="apriltag" namespace="apriltag" output="screen">
    <!-- The 4 corner tags actually printed/placed are Standard41h12
         ids 0-3 at 20mm (tags_41h12.yaml). 36h11/tags_36h11.yaml was a
         separate, unrelated 2-tag ("base"/"object") setup that doesn't
         match what's physically on the bed, which is why detections
         were coming back empty despite the tags being clearly visible
         in the camera image. -->
    <param name="family" value="Standard41h12"/>
    <param from="$(find-pkg-share apriltag_ros)/cfg/tags_41h12.yaml"/>
    <!-- camera_name="camera" plus camera_namespace="camera" below doubles
         the topic path to /camera/camera/... (realsense2_camera's own
         namespacing, confirmed directly via `ros2 topic list` while
         running), not /camera/... -->
    <remap from="image_rect" to="/camera/camera/color/image_raw"/>
    <remap from="camera_info" to="/camera/camera/color/camera_info"/>
  </node>

  <node pkg="meca500_demo" exec="planningscene_april_tag" name="planningscene_april_tag" output="screen">
    <param name="base_frame" value="link_0__base"/>
  </node>

  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(var rviz_config)"/>
</launch>
