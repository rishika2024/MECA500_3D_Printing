<launch>
    <arg name='use_mock_hardware' default='true' description='true = sim, false = real Meca500'/>
    <arg name='use_extruder' default='true' description='Attach the extruder end-effector meshes (true) or bare flange (false)'/>
    <arg name='use_background' default='true' description='Attach the Ender3 environment meshes (true) or not (false)'/>
    <arg name='real_print' default='true' description='true = send gcode to Ender3, false = simulate only'/>

    <!-- demo.launch.py owns the full robot_description build (arm + extruder +
         background environment, with the calibrated mount offset) since it's
         the one that spawns robot_state_publisher, the only thing RViz's
         RobotModel display actually reads. -->
    <include file='$(find-pkg-share meca500_moveit)/launch/demo.launch.py'>
        <arg name='use_mock_hardware' value='$(var use_mock_hardware)'/>
        <arg name='use_rviz' value='false'/>
        <arg name='use_extruder' value='$(var use_extruder)'/>
        <arg name='use_background' value='$(var use_background)'/>
    </include>

    <node pkg='rviz2' exec='rviz2' output='screen'
          args='-d $(find-pkg-share meca500_demo)/config/traj.rviz'/>

    <node pkg='meca500_demo' exec='trajectory'>
        <param name="robot_description" value="$(command 'xacro $(find-pkg-share meca500_moveit)/config/meca500.urdf.xacro use_mock_hardware:=$(var use_mock_hardware) use_extruder:=$(var use_extruder)')" type="str"/>
        <param name="robot_description_semantic" value="$(command 'cat $(find-pkg-share meca500_moveit)/config/meca500.srdf')" type="str"/>
        <param from='$(find-pkg-share meca500_demo)/config/trajectory_kinematics.yaml'/>
        <param name='use_mock_hardware' value='$(var use_mock_hardware)'/>
        <param name='use_extruder' value='$(var use_extruder)'/>        
        <param name='real_print' value='$(var real_print)'/>
    </node>
</launch>