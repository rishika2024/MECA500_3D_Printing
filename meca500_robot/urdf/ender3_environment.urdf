  <!-- Fixed joint mounting the environment to link_0__base. The offset is
       supplied via env_x/env_y/env_z/env_roll/env_pitch/env_yaw (declared in
       robot.urdf.xacro, default identity) rather than hardcoded here, so the
       calibrated placement lives in whatever launch file sets those args.
       The calibrated values, recovered by comparing link_0__base's pose in
       the original combined onshape-to-robot export against its own-frame
       origin in meca500.urdf and cross-checked against a second landmark
       (link_6__flange FK) to sub-100-micron agreement, are:
       xyz="-0.1034567 -0.0740003 -0.08937016" rpy="0 0 -3.14159". This mount
       transform is unaffected by the bed/Y-carriage addition below, since
       link_0__base's own landmark position did not change between exports. -->
  <joint name="ender3_environment_joint" type="fixed">
    <origin xyz="$(arg env_x) $(arg env_y) $(arg env_z)" rpy="$(arg env_roll) $(arg env_pitch) $(arg env_yaw)"/>
    <parent link="link_0__base"/>
    <child link="ender3_environment"/>
  </joint>
</robot>
