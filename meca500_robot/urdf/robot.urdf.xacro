<?xml version="1.0" ?>
<!-- Re-rooted from the home-referenced Onshape export (doc 0427f697...).
     Tree inverted mathematically: base is root, mates in Onshape untouched.
     Zero position = true Meca500 home. Axis 0 0 -1 preserves the export's
     rotation sense. Verified FK-equivalent to the export at machine precision. -->
<robot name="meca500" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="use_extruder" default="true"/>
  <xacro:arg name="joint_offsets_file" default="$(find meca500_moveit)/config/joint_offsets.yaml"/>
  <xacro:arg name="initial_positions_file" default="$(find meca500_moveit)/config/initial_positions.yaml"/>

  <xacro:include filename="$(find mecha500_robot)/urdf/robot.ros2_control.xacro" />

  <xacro:meca500_ros2_control name="meca500" prefix="" use_mock_hardware="$(arg use_mock_hardware)"
    joint_offsets_file="$(arg joint_offsets_file)"
    initial_positions_file="$(arg initial_positions_file)"/>

  <link name="link_0__base">
